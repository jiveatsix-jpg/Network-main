{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Red Ops Tracker",
  "version": "1.0.0",
  "identifier": "com.jiveatsix.redops",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "title": "RED // OPS TRACKER",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
